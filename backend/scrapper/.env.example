# MongoDB Configuration
MONGODB_URI=mongodb://username:password@localhost:27017/fuse?authSource=admin

# redis config
REDIS_URI=redis://localhost:6379

# App Configuration
SCRAPPER_PORT=5000
NODE_ENV=development

# Min time to retry summary extraction
SUMMARY_REFRESH_THRESHOLD_HRS=3600

# used for summarizing data
GEMINI_API_KEY=gemini_api_key
GEMINI_MODEL_NAME=gemini-2.0-flash

SQS_URI=http://localhost:9324
SQS_REGION=us-west-1
SQS_ACCESS_KEY_ID=dummy_access_key
SQS_SECRET_ACCESS_KEY=dummy_secret_key

# sqs scrapping tasks queue
SCRAPPER_QUEUE=scrapper-queue

# max messages, a scrapper can process concurrently
MAX_CONCURRENT_TASKS=3

# visibility timeout for msg in queue
VISIBILITY_TIMEOUT=180
WAIT_TIME_SECONDS=20


# webshare proxy
PROXY_USERNAME=webshare-username
PROXY_PASSWORD=webshare-password
PROXY_URL=http://proxy.webshare.io:80

# puppeteer config
USEPROXY_PUPPETEER=true
HEADLESS_PUPPETEER=false